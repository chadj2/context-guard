// The formatter, oxfmt (Prettier's layout): `npm run format` rewrites, and `npm run format:check` checks.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // .editorconfig's limit. A string longer than it stays on one line.
  "printWidth": 120,
  "singleQuote": true,
  "arrowParens": "avoid",
  "quoteProps": "consistent",
  // npm writes package.json in its own order.
  "sortPackageJson": false,
  "ignorePatterns": [
    // A formatter would pad every Markdown table, so one changed cell changes them all.
    "**/*.md",
    "package-lock.json",
    // Claude Code's API types, which it writes in its own layout (README.md §5.2).
    ".claude-plugin/types/**",
  ],
}
